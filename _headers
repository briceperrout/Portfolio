# En-têtes de sécurité (Cloudflare Workers Assets / Pages). S'appliquent aux fichiers statiques ;
# les réponses de /api/* portent leurs propres en-têtes (worker.js).
#
# Content-Security-Policy stricte : aucun script tiers ni inline, aucune connexion hors de l'origine.
#  - script-src 'self'            : modules locaux uniquement (index.html n'a aucun <script> inline)
#  - style-src 'unsafe-inline'    : le CSS est inline dans index.html (CLAUDE.md) et le code pose des style="" ; aucun hôte tiers
#  - font-src 'self'              : polices Inter / Manrope hébergées dans vendor/fonts/ (aucun Google Fonts, aucun CDN)
#  - connect-src 'self'           : /api/chat, /api/statut, /api/sync et dvf/*.json (même origine) seulement
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), geolocation=(), payment=(), microphone=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Le service worker doit toujours être revalidé : une nouvelle version est détectée au prochain chargement.
/service-worker.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache

# Données DVF volumineuses : le service worker les met en cache à la demande, le navigateur les revalide.
/dvf/*
  Cache-Control: public, max-age=0, must-revalidate
