# Plan Patrimoine — variables d'environnement (EXEMPLE)
# Copiez ce fichier en `.env` (ignoré par Git) et renseignez vos propres valeurs.
# Ne committez JAMAIS de vraie clé : elle ne doit vivre que côté serveur
# (serveur.py en local, secrets Cloudflare en production), jamais dans le code client.

# ── Serveur local ────────────────────────────────────
# Port d'écoute (surchargé par l'argument : python3 serveur.py 8080)
PORT=8080

# ── Assistant IA ─────────────────────────────────────
# Clé OpenAI, à créer sur https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Modèle pour le chat général / synthèse (défaut du code : gpt-5.4-mini ; effort « low », 1500 tokens de sortie)
OPENAI_MODEL_CHAT=gpt-5.4-mini
# Modèle pour le raisonnement complexe (arbitrages fiscaux, simulations) : bouton « 🧠 Analyse approfondie »
# ou mot-clé complexe dans la question (sasu, holding, succession, ifi…). Défaut du code : o3 (effort « medium », 2500 tokens)
OPENAI_MODEL_REASONING=o3
# Si OpenAI refuse ce modèle (introuvable/déprécié, organisation non vérifiée…), la requête est rejouée sur le modèle rapide en effort « high »
# 1 (défaut) = routage vers le modèle de raisonnement actif ; 0 = coupe-circuit, tout reste sur le modèle rapide
OPENAI_ENABLE_REASONING=1
# Plafonds de sortie (reasoning_tokens inclus) : raisonnement (et repli « high ») / modèle rapide
# OPENAI_MAX_COMPLETION_TOKENS=2500
# OPENAI_MAX_COMPLETION_TOKENS_FAST=1500
# Quotas gratuits Data Sharing, comptés séparément par jour UTC (prompt + completion, raisonnement inclus) :
#  - modèles mini (2,5 M gratuits) : plafond de sécurité ; au-delà, l'API répond 429 « quota_journalier » et l'assistant retombe en local
OPENAI_QUOTA_RAPIDE_MAX=2350000
#  - modèles phares comme o3 (250 k gratuits) : plafond ; au-delà, repli sur le modèle rapide en effort « high »
OPENAI_QUOTA_RAISONNEMENT_MAX=225000
# Seuils d'alerte dans la console du serveur (modèles mini / modèles phares)
OPENAI_DAILY_TOKEN_ALERT=2200000
# OPENAI_DAILY_TOKEN_ALERT_REASONING=200000

# Production (worker.js) : origine autorisée si le site et le Worker sont sur des domaines différents
# ALLOWED_ORIGIN=https://plan-patrimoine.pages.dev

# ── Ollama (analyse locale de documents non anonymisables) ─
OLLAMA_URL=http://localhost:11434

# ── Déploiement Cloudflare (prévu) ───────────────────
TURNSTILE_SECRET_KEY=
