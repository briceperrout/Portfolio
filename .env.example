# Plan Patrimoine — variables d'environnement (EXEMPLE)
# Copiez ce fichier en `.env` (ignoré par Git) et renseignez vos propres valeurs.
# Ne committez JAMAIS de vraie clé : elle ne doit vivre que côté serveur
# (serveur.py en local, secrets Cloudflare en production), jamais dans le code client.

# ── Serveur local ────────────────────────────────────
# Port d'écoute (surchargé par l'argument : python3 serveur.py 8080)
PORT=8080

# ── Assistant IA ─────────────────────────────────────
# Clé OpenAI, à créer sur https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Modèle pour le chat général / synthèse
OPENAI_MODEL_CHAT=gpt-4.1-mini
# Modèle pour le raisonnement complexe (arbitrages fiscaux, simulations), utilisé seulement si activé ci-dessous
OPENAI_MODEL_REASONING=o4-mini
OPENAI_ENABLE_REASONING=0
# Seuil d'alerte de quota journalier (tokens)
OPENAI_DAILY_TOKEN_ALERT=2200000

# Production (worker.js) : origine autorisée si le site et le Worker sont sur des domaines différents
# ALLOWED_ORIGIN=https://plan-patrimoine.pages.dev

# ── Ollama (analyse locale de documents non anonymisables) ─
OLLAMA_URL=http://localhost:11434

# ── Déploiement Cloudflare (prévu) ───────────────────
TURNSTILE_SECRET_KEY=
